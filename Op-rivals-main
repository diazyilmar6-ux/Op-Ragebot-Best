local mag=(Vector2.new(sp.X,sp.Y)-center).Magnitude
if mag<=fovR and mag<bestMag and hasLineOfSight(rayOrigin,pt,e.char)then
bestMag,bestPart,bestPlayer=mag,pt,e.player
end
end
end
end
end
return bestPart,bestPlayer
end

