local function isEnemy(p)
if not p or p==lplr then return false end
local duel=SpectateController.CurrentDuelSubject
if duel and duel.Duelers then
local myTeam=nil
for _,du in ipairs(duel.Duelers)do if du.Player==lplr then myTeam=du:Get("TeamID")if myTeam==nil then myTeam=du.TeamID end break end end
if myTeam~=nil then
for _,du in ipairs(duel.Duelers)do if du.Player==p then local theirTeam=du:Get("TeamID")if theirTeam==nil then theirTeam=du.TeamID end if theirTeam~=nil then return theirTeam~=myTeam end end end
end
end
if lplr:GetAttribute("TeamID")~=nil and p:GetAttribute("TeamID")~=nil then return lplr:GetAttribute("TeamID")~=p:GetAttribute("TeamID")end
if lplr.Team and p.Team then return lplr.Team~=p.Team end
return true
end

local function hasLineOfSight(originPos,targetPart,targetChar)
if not getgenv().Config.WallCheck then return true end
if not targetPart or not targetPart.Parent then return false end
local params=RaycastParams.new()
params.FilterType=Enum.RaycastFilterType.Exclude
local ignore={cam}
if lplr.Character then table.insert(ignore,lplr.Character)end
if targetChar then table.insert(ignore,targetChar)end
if npcVoidClone then table.insert(ignore,npcVoidClone)end
if npcBackClone then table.insert(ignore,npcBackClone)end
params.FilterDescendantsInstances=ignore
params.IgnoreWater=true
local dir=targetPart.Position-originPos
if dir.Magnitude<=0.01 then return true end
local res=workspace:Raycast(originPos,dir,params)
if not res then return true end
if targetChar and res.Instance:IsDescendantOf(targetChar)then return true end
return false
end

