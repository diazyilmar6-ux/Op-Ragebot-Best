local currentFullScript = ""
local typeToken = 0

local function TypeWriteScript(fullText)
    currentFullScript = fullText or ""
    typeToken += 1
    local token = typeToken
    CodeBox.Text = ""
    task.spawn(function()
        for i = 1, #currentFullScript do
            if typeToken ~= token then return end
            CodeBox.Text = string.sub(currentFullScript, 1, i)
            task.wait(0.008)
        end
    end)
end

local function SetInstantScript(fullText)
    typeToken += 1
    currentFullScript = fullText or ""
    CodeBox.Text = currentFullScript
end

local function GetFullPath(inst)
    if not inst then return "nil" end
    local path = ""
    local current = inst
    while current and current ~= game do
        local name = current.Name
        if name:match("^[%a_][%w_]*$") then
            path = "." .. name .. path
        else
            path = string.format("[%q]", name) .. path
        end
        current = current.Parent
    end
    return "game" .. path
end

local function SerializeArgs(args)
    local serialized = {}
    for _, v in ipairs(args) do
        local t = typeof(v)
        if t == "string" then
            table.insert(serialized, string.format("%q", v))
        elseif t == "number" or t == "boolean" then
            table.insert(serialized, tostring(v))
        elseif t == "Instance" then
            table.insert(serialized, GetFullPath(v))
        elseif t == "Vector3" then
            table.insert(serialized, string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z))
        elseif t == "CFrame" then
            table.insert(serialized, string.format("CFrame.new(%s)", tostring(v)))
        elseif t == "table" then
            table.insert(serialized, "{}")
        else
            table.insert(serialized, "nil")
        end
    end
    return table.concat(serialized, ", ")
end

local function GetDelayValue()
    local num = tonumber(DelayBox.Text)
    return (num and num >= 0) and num or 0.6
end

local autoFarmOn = false
local instantStealOn = false
local lastMiniScript = ""
local lastPromptName = nil
local lastPromptParentPath = nil
local lastPromptPath = nil
local lastActionKind = nil
local lastRemoteMethod = nil
local lastRemoteArgsStr = ""

local function BuildAutoFarmScript(delaySec)
    if lastActionKind == "Prompt" and lastPromptPath then
        return string.format("local delayTime = %s\nwhile task.wait(delayTime) do\n    local p = %s\n    if p and p:IsA('ProximityPrompt') and fireproximityprompt then\n        fireproximityprompt(p)\n    end\nend", tostring(delaySec), lastPromptPath)
    elseif lastActionKind == "Click" and lastPromptPath then
        return string.format("local delayTime = %s\nwhile task.wait(delayTime) do\n    local c = %s\n    if c and c:IsA('ClickDetector') and fireclickdetector then\n        fireclickdetector(c)\n    end\nend", tostring(delaySec), lastPromptPath)
    elseif lastActionKind == "Remote" and lastPromptPath and lastRemoteMethod then
        return string.format("local delayTime = %s\nwhile task.wait(delayTime) do\n    local r = %s\n    if r then\n        r:%s(%s)\n    end\nend", tostring(delaySec), lastPromptPath, lastRemoteMethod, lastRemoteArgsStr)
    elseif lastMiniScript ~= "" then
        return string.format("local delayTime = %s\nwhile task.wait(delayTime) do\n%s\nend", tostring(delaySec), lastMiniScript)
    end
    return string.format("local delayTime = %s\nwhile task.wait(delayTime) do\n    -- Toca un objeto, pantalla o ProximityPrompt\nend", tostring(delaySec))
end

local function BuildInstantStealScript()
    local targetName = lastPromptName or ""
    local parentPath = lastPromptParentPath or "workspace"
    local promptPath = lastPromptPath or "nil"
    return string.format("local targetName = %q\nlocal parentRef = %s\nlocal directPrompt = %s\nlocal function grabPrompt(pr)\n    if pr and pr:IsA('ProximityPrompt') and fireproximityprompt then\n        fireproximityprompt(pr)\n    end\nend\nif directPrompt and directPrompt:IsA('ProximityPrompt') then\n    grabPrompt(directPrompt)\nend\nfor _, d in ipairs(workspace:GetDescendants()) do\n    if d:IsA('ProximityPrompt') and (d.Name == targetName or d:GetFullName() == directPrompt) then\n        grabPrompt(d)\n    end\nend\nworkspace.DescendantAdded:Connect(function(d)\n    if d:IsA('ProximityPrompt') and (targetName == '' or d.Name == targetName) then\n        task.wait()\n        grabPrompt(d)\n    end\nend)", targetName, parentPath, promptPath)
end

task.spawn(function()
    while true do
        local d = GetDelayValue()
        if autoFarmOn then
            if lastActionKind == "Prompt" and lastPromptPath then
                local fn = loadstring(string.format("local p = %s; if p and fireproximityprompt then fireproximityprompt(p) end", lastPromptPath))
                if fn then task.spawn(fn) end
            elseif lastActionKind == "Click" and lastPromptPath then
                local fn = loadstring(string.format("local c = %s; if c and fireclickdetector then fireclickdetector(c) end", lastPromptPath))
                if fn then task.spawn(fn) end
            elseif lastActionKind == "Remote" and lastPromptPath and lastRemoteMethod then
                local fn = loadstring(string.format("local r = %s; if r then r:%s(%s) end", lastPromptPath, lastRemoteMethod, lastRemoteArgsStr))
                if fn then task.spawn(fn) end
            elseif lastMiniScript ~= "" then
                local fn = loadstring(lastMiniScript)
                if fn then task.spawn(fn) end
            end
        end
        task.wait(d)
    end
end)

local function TryStealPrompt(prompt)
    if not instantStealOn or not prompt or not prompt:IsA("ProximityPrompt") then return end
    local matchesName = (lastPromptName ~= nil and prompt.Name == lastPromptName)
    local matchesPath = (lastPromptPath ~= nil and GetFullPath(prompt) == lastPromptPath)
    if matchesName or matchesPath or (lastPromptName == nil and lastPromptPath == nil) then
        if fireproximityprompt then fireproximityprompt(prompt) end
    end
end

Workspace.DescendantAdded:Connect(function(desc)
    if instantStealOn and desc:IsA("ProximityPrompt") then
        task.wait()
        TryStealPrompt(desc)
    end
end)

