local function FindTargetAction(target)
    if not target then return nil, nil end
    for _, obj in ipairs({target, target.Parent}) do
        if obj and obj ~= Workspace and obj ~= game then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then return prompt, "ProximityPrompt" end
            local click = obj:FindFirstChildWhichIsA("ClickDetector", true)
            if click then return click, "ClickDetector" end
            local remote = obj:FindFirstChildWhichIsA("RemoteEvent", true) or obj:FindFirstChildWhichIsA("RemoteFunction", true)
            if remote then return remote, remote.ClassName end
        end
    end
    if target:IsA("BasePart") or (target.Parent and target.Parent:IsA("Model")) then
        return (target.Parent and target.Parent:IsA("Model") and target.Parent) or target, "ServerMod"
    end
    return nil, nil
end

