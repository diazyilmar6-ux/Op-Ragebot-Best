local BlockedRemotes, ExcludedRemotes, HookedCallbacks = {}, {}, {}
local SimpleSpy = {}
function SimpleSpy:HookRemote(remote, callback) HookedCallbacks[remote] = callback end
function SimpleSpy:BlockRemote(remote) BlockedRemotes[remote] = true end
function SimpleSpy:ExcludeRemote(remote) ExcludedRemotes[remote] = true end

local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall
mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" or method == "InvokeServer" then
        if BlockedRemotes[self] then return nil end
        if HookedCallbacks[self] then
            local modified = HookedCallbacks[self](...)
            if modified == nil then return nil end
            args = modified
        end
        if not ExcludedRemotes[self] then
            local remotePath = GetFullPath(self)
            local argsStr = SerializeArgs(args)
            task.spawn(function()
                lastPromptPath, lastActionKind, lastRemoteMethod, lastRemoteArgsStr = remotePath, "Remote", method, argsStr
                lastMiniScript = string.format("%s:%s(%s)", remotePath, method, argsStr)
                if not autoFarmOn and not instantStealOn then
                    SetInstantScript(lastMiniScript)
                elseif autoFarmOn then
                    SetInstantScript(BuildAutoFarmScript(GetDelayValue()))
                end
            end)
        end
        return oldNamecall(self, unpack(args))
    end
    return oldNamecall(self, ...)
end
setreadonly(mt, true)

local function CopyFullToClipboard(text)
    local toCopy = text or ""
    if setclipboard then setclipboard(toCopy)
    elseif toClipboard then toClipboard(toCopy)
    elseif syn and syn.write_clipboard then syn.write_clipboard(toCopy) end
end

