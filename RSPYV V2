local function RecordPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    lastPromptName = prompt.Name
    lastPromptParentPath = GetFullPath(prompt.Parent)
    lastPromptPath = GetFullPath(prompt)
    lastActionKind = "Prompt"
    lastMiniScript = string.format("fireproximityprompt(%s)", lastPromptPath)
    if not autoFarmOn and not instantStealOn then
        SetInstantScript(lastMiniScript)
    elseif autoFarmOn then
        TypeWriteScript(BuildAutoFarmScript(GetDelayValue()))
    elseif instantStealOn then
        TypeWriteScript(BuildInstantStealScript())
    end
end

ProximityService.PromptTriggered:Connect(function(prompt, player)
    if player == LocalPlayer and prompt then RecordPrompt(prompt) end
end)

local function HookPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        local cachedName = prompt.Name
        local cachedParentPath = GetFullPath(prompt.Parent)
        local cachedPath = GetFullPath(prompt)
        prompt:GetPropertyChangedSignal("Parent"):Connect(function()
            if prompt.Parent == nil then
                cachedName = prompt.Name
                cachedPath = GetFullPath(prompt)
            else
                cachedParentPath = GetFullPath(prompt.Parent)
                cachedPath = GetFullPath(prompt)
            end
        end)
