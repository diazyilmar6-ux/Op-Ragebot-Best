-- Captura automática de ProximityPrompt (incluso si se borra)
local function HookPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        local model, modelName = ResolveNamedModel(prompt)
        local cachedName = modelName or prompt.Name
        local cachedModelPath = model and GetFullPath(model) or GetFullPath(prompt.Parent)
        local cachedPromptPath = GetFullPath(prompt)

        prompt:GetPropertyChangedSignal("Parent"):Connect(function()
            local m, mn = ResolveNamedModel(prompt)
            if mn and mn ~= "" then cachedName = mn end
            if m then cachedModelPath = GetFullPath(m) end
            cachedPromptPath = GetFullPath(prompt)
        end)

        prompt.Triggered:Connect(function(plr)
            if plr == LocalPlayer then
                lastTargetName = cachedName
                lastTargetPath = cachedModelPath
                lastPromptPath = cachedPromptPath
                lastActionKind = "Prompt"
                lastMiniScript = string.format("fireproximityprompt(%s)", cachedPromptPath)
                if autoFarmOn then
                    TypeWriteScript(BuildAutoFarmScript(GetDelayValue()))
                elseif instantStealOn then
                    TypeWriteScript(BuildInstantStealScript())
                else
                    SetInstantScript(lastMiniScript)
                end
            end
        end)
    end
end

