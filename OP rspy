local function BuildAutoFarmScript(delaySec)
    if lastActionKind == "Prompt" and lastPromptPath then
        return string.format("local spd = %s\nwhile task.wait(spd) do\n    local p = %s\n    if p and p:IsA('ProximityPrompt') and fireproximityprompt then\n        fireproximityprompt(p)\n    end\nend", tostring(delaySec), lastPromptPath)
    elseif lastActionKind == "Click" and lastPromptPath then
        return string.format("local spd = %s\nwhile task.wait(spd) do\n    local c = %s\n    if c and c:IsA('ClickDetector') and fireclickdetector then\n        fireclickdetector(c)\n    end\nend", tostring(delaySec), lastPromptPath)
    elseif lastActionKind == "Remote" and lastPromptPath and lastRemoteMethod then
        return string.format("local spd = %s\nwhile task.wait(spd) do\n    local r = %s\n    if r then\n        r:%s(%s)\n    end\nend", tostring(delaySec), lastPromptPath, lastRemoteMethod, lastRemoteArgsStr)
    elseif lastTargetPath then
        return string.format("local spd = %s\nwhile task.wait(spd) do\n    local m = %s\n    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')\n    if m and root then\n        if m:IsA('Model') then m:PivotTo(root.CFrame * CFrame.new(0, 0, -3)) elseif m:IsA('BasePart') then m.CFrame = root.CFrame * CFrame.new(0, 0, -3) end\n    end\nend", tostring(delaySec), lastTargetPath)
    end
    return string.format("local spd = %s\nwhile task.wait(spd) do\nend", tostring(delaySec))
end

local function BuildInstantStealScript()
    local objName = lastTargetName or ""
    local objPath = lastTargetPath or "nil"
    local prPath = lastPromptPath or "nil"
    return string.format("local objName = %q\nlocal directObj = %s\nlocal directPrompt = %s\nlocal function pullHere(target)\n    local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')\n    if not target or not root then return end\n    local cf = root.CFrame * CFrame.new(0, 0, -3)\n    if target:IsA('Model') then target:PivotTo(cf) elseif target:IsA('BasePart') then target.CFrame = cf end\n    for _, d in ipairs(target:GetDescendants()) do if d:IsA('BasePart') then d.CFrame = cf end end\nend\nlocal function takePrompt(pr)\n    if pr and pr:IsA('ProximityPrompt') and fireproximityprompt then\n        fireproximityprompt(pr)\n        local model = pr:FindFirstAncestorOfClass('Model')\n        pullHere(model or pr.Parent)\n    end\nend\nif directPrompt and directPrompt:IsA('ProximityPrompt') then takePrompt(directPrompt) end\nfor _, d in ipairs(workspace:GetDescendants()) do\n    if d:IsA('ProximityPrompt') and objName ~= '' then\n        local m = d:FindFirstAncestorOfClass('Model')\n        if (m and m.Name == objName) or d.Name == objName then takePrompt(d) end\n    end\nend\nworkspace.DescendantAdded:Connect(function(d)\n    if d:IsA('ProximityPrompt') and objName ~= '' then\n        local m = d:FindFirstAncestorOfClass('Model')\n        if (m and m.Name == objName) or d.Name == objName then\n            task.wait()\n            takePrompt(d)\n        end\n    end\nend)", objName, objPath, prPath)
end

