local function RestoreNoclip()
    local char = LocalPlayer.Character
    if char then
        for part, wasCanCollide in pairs(originalCollision) do
            if part and part.Parent then part.CanCollide = wasCanCollide end
        end
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") and originalCollision[obj] == nil then
                obj.CanCollide = true
            end
        end
    end
    table.clear(originalCollision)
end

NoclipBtn.MouseButton1Click:Connect(function()
    noclipOn = not noclipOn
