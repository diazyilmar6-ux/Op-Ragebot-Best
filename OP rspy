            elseif lastActionKind == "Remote" and lastPromptPath and lastRemoteMethod then
                local fn = loadstring(string.format("local r = %s; if r then r:%s(%s) end", lastPromptPath, lastRemoteMethod, lastRemoteArgsStr))
                if fn then task.spawn(fn) end
            elseif lastTargetPath then
                local fn = loadstring(string.format("local m = %s; local root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart'); if m and root then local cf = root.CFrame * CFrame.new(0, 0, -3); if m:IsA('Model') then m:PivotTo(cf) elseif m:IsA('BasePart') then m.CFrame = cf end end", lastTargetPath))
                if fn then task.spawn(fn) end
            end
        end
        task.wait(spd)
    end
end)

-- Instant Steal: busca en el mapa el mismo objeto/modelo con nombre, agarra con ProximityPrompt y trae a tu posición sin moverte
local function ProcessInstantStealPrompt(prompt)
    if not instantStealOn or not prompt or not prompt:IsA("ProximityPrompt") then return end
    local model, modelName = ResolveNamedModel(prompt)
    local matches = false
    if lastTargetName and lastTargetName ~= "" then
        if (modelName and modelName == lastTargetName) or prompt.Name == lastTargetName then
            matches = true
        end
    elseif lastPromptPath and GetFullPath(prompt) == lastPromptPath then
        matches = true
    end
    if matches then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
        BringToPlayerPosition(model or prompt.Parent)
    end
end

