-- Hook __namecall + SimpleSpy
local BlockedRemotes, ExcludedRemotes, HookedCallbacks = {}, {}, {}
local SimpleSpy = {}
function SimpleSpy:HookRemote(remote, cb) HookedCallbacks[remote] = cb end
function SimpleSpy:BlockRemote(remote) BlockedRemotes[remote] = true end
function SimpleSpy:ExcludeRemote(remote) ExcludedRemotes[remote] = true end

local mt = getrawmetatable(game)
setreadonly(mt, false)
local oldNamecall = mt.__namecall
mt.__namecall = function(self, ...)
    local method = getnamecallmethod()
    local args = {...}
    if method == "FireServer" or method == "InvokeServer" then
        if BlockedRemotes[self] then return nil end
        if HookedCallbacks[self] then
            local mod = HookedCallbacks[self](...)
            if mod == nil then return nil end
            args = mod
        end
        if not ExcludedRemotes[self] then
            local p = GetFullPath(self)
            local a = SerializeArgs(args)
            task.spawn(function()
                lastPromptPath, lastActionKind, lastRemoteMethod, lastRemoteArgsStr = p, "Remote", method, a
                lastMiniScript = string.format("%s:%s(%s)", p, method, a)
                SetInstantScript(autoFarmOn and BuildAutoFarmScript(GetDelayValue()) or lastMiniScript)
            end)
        end
        return oldNamecall(self, unpack(args))
    end
    return oldNamecall(self, ...)
end
setreadonly(mt, true)

-- Botones EXECUTE, CLEAR y COPY (copia el script completo sin recortes)
local function WriteClipboard(str)
    local payload = str or ""
    if setclipboard then setclipboard(payload)
    elseif toClipboard then toClipboard(payload)
    elseif syn and syn.write_clipboard then syn.write_clipboard(payload) end
end

