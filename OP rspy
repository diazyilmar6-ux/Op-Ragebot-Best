local fullScriptBuffer = ""
local typeToken = 0

local function TypeWriteScript(fullText)
    fullScriptBuffer = fullText or ""
    typeToken += 1
    local token = typeToken
    CodeBox.Text = ""
    task.spawn(function()
        for i = 1, #fullScriptBuffer do
            if typeToken ~= token then return end
            CodeBox.Text = string.sub(fullScriptBuffer, 1, i)
            task.wait(0.008)
        end
    end)
end

local function SetInstantScript(fullText)
    typeToken += 1
    fullScriptBuffer = fullText or ""
    CodeBox.Text = fullScriptBuffer
end

CodeBox:GetPropertyChangedSignal("Text"):Connect(function()
    if typeToken == 0 then
        fullScriptBuffer = CodeBox.Text
    end
end)

local function GetFullPath(inst)
    if not inst then return "nil" end
    local path = ""
    local cur = inst
    while cur and cur ~= game do
        local n = cur.Name
        if n:match("^[%a_][%w_]*$") then
            path = "." .. n .. path
        else
            path = string.format("[%q]", n) .. path
        end
        cur = cur.Parent
    end
    return "game" .. path
end

local function SerializeArgs(args)
    local out = {}
    for _, v in ipairs(args) do
        local t = typeof(v)
        if t == "string" then
            table.insert(out, string.format("%q", v))
        elseif t == "number" or t == "boolean" then
            table.insert(out, tostring(v))
        elseif t == "Instance" then
            table.insert(out, GetFullPath(v))
        elseif t == "Vector3" then
            table.insert(out, string.format("Vector3.new(%s, %s, %s)", v.X, v.Y, v.Z))
        elseif t == "CFrame" then
            table.insert(out, string.format("CFrame.new(%s)", tostring(v)))
        elseif t == "table" then
            table.insert(out, "{}")
        else
            table.insert(out, "nil")
        end
    end
    return table.concat(out, ", ")
end

local function GetDelayValue()
    local num = tonumber(DelayBox.Text)
    return (num and num >= 0) and num or 0.6
end

-- Resuelve el nombre del objeto con su modelo completo (nunca Part/Model suelto sin nombre/modelo)
local function ResolveNamedModel(inst)
    if not inst or inst == Workspace or inst == game then return nil, nil end
    local model = inst:FindFirstAncestorOfClass("Model")
    if model and model ~= Workspace and model.Name ~= "" then
        return model, model.Name
    end
    if inst.Name ~= "" and not inst:IsA("BasePart") then
        return inst, inst.Name
    end
    return nil, nil
end

-- Trae el objeto/modelo completo a la posición actual del jugador sin moverse
local function BringToPlayerPosition(obj)
    if not obj or not obj.Parent then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local targetCF = root.CFrame * CFrame.new(0, 0, -3)
    if obj:IsA("Model") then
        pcall(function()
            obj:PivotTo(targetCF)
        end)
    elseif obj:IsA("BasePart") then
        pcall(function()
            obj.CFrame = targetCF
        end)
    end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then
            pcall(function()
                d.CFrame = targetCF
            end)
        end
    end
end

