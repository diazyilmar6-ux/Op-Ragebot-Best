-- Captura automática al tocar objetos/pantallas: solo nombre con modelo completo (nunca Part/Model suelto)
local function BuildNamedObjectScript(target)
    local model, modelName = ResolveNamedModel(target)
    if not model or not modelName or modelName == "" then
        return ""
    end
    local modelPath = GetFullPath(model)
    lastTargetName = modelName
    lastTargetPath = modelPath

    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        lastPromptPath = GetFullPath(prompt)
        lastActionKind = "Prompt"
        return string.format("fireproximityprompt(%s)", lastPromptPath)
    end

    local click = model:FindFirstChildWhichIsA("ClickDetector", true)
    if click then
        lastPromptPath = GetFullPath(click)
        lastActionKind = "Click"
        return string.format("fireclickdetector(%s)", lastPromptPath)
    end

    local remote = model:FindFirstChildWhichIsA("RemoteEvent", true) or model:FindFirstChildWhichIsA("RemoteFunction", true)
    if remote then
        local m = remote:IsA("RemoteEvent") and "FireServer" or "InvokeServer"
        lastPromptPath = GetFullPath(remote)
        lastActionKind = "Remote"
        lastRemoteMethod = m
        lastRemoteArgsStr = ""
        return string.format("%s:%s()", lastPromptPath, m)
    end

    lastActionKind = "Model"
    return string.format("local model = %s\nlocal root = game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild('HumanoidRootPart')\nif model and root then\n    model:PivotTo(root.CFrame * CFrame.new(0, 0, -3))\nend", modelPath)
end

