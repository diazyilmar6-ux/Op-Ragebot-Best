(myChar) end; if not c.Ragebot and not c.Rage then F.clearDualNPCs(); if (now - S.lastUIUpdate) >= 0.08 and a then S.lastUIUpdate = now; local at = c.Aimbot and (sP and (" | Aimbot -> " .. sP.Name) or " | Aimbot ON") or ""; a.Text = "RAYFIELD | Modo Manual" .. at; a.BackgroundColor3 = Color3.fromRGB(45, 47, 56) end; return end; if not sP or not sH or not sR or not FighterController.LocalFighter then F.clearDualNPCs(); if (now - S.lastUIUpdate) >= 0.08 and a then S.lastUIUpdate = now; a.Text = "RAYFIELD | Buscando enemigos válidos (2v2 / 1v1)..."; a.BackgroundColor3 = Color3.fromRGB(40, 42, 50) end; return end; local is2v2 = #validEnemies >= 2; local mateAlive, mate = F.isTeammateAlive(); if is2v2 and c.WaitForTeammateDeath2v2 and mateAlive then F.clearDualNPCs(); if (now - S.lastUIUpdate) >= 0.08 and a then S.lastUIUpdate = now; a.Text = "⏳ 2V2 ESPERANDO | Esperando que muera " .. (mate and mate.Name or "Compañero") .. "..."; a.BackgroundColor3 = Color3.fromRGB(140, 105, 22) end; return end; if c.Rage then executeRivalsRageTwoParts(now, myRoot, sR, sH, sP, validEnemies, trigPart) end; if not c.Ragebot then F.clearDualNPCs(); if (now - S.lastUIUpdate) >= 0.08 and a then S.lastUIUpdate = now; a.Text = "🔥 RAGE (2 PARTES) ACTIVO | Objetivo: " .. sP.Name; a.BackgroundColor3 = Color3.fromRGB(155, 45, 85) end; return end; local ew = S.enemyWep[sP]; local hasThreat = ew and S.threatWeapons[ew] or false; local isKnife = (ew == "Knife" or ew == "Cuchillo"); local isYellow = (not is2v2) and (not hasThreat) and S.isWaiting99k; local bCF = CFrame.lookAt((sR.CFrame * CFrame.new(0, 1, c.NPCBackOffset)).Position, sH.Position); local vCF = CFrame.lookAt(sR.Position + Vector3.new(0, c.NPCVoidHeight, 0), sH.Position); updateDualNPCs(myChar, vCF, bCF, now); local tPos; if is2v2 then tPos = (sR.CFrame * CFrame.new(0, 1, 0)).Position elseif hasThreat then tPos = sR.Position + Vector3.new(0, c.Threat500k, 0) elseif isKnife then tPos = (sR.CFrame * CFrame.new(0, c.KnifeHeight, -c.KnifeForw