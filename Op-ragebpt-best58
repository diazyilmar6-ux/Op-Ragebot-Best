local function getTriggerPart(enemyList) local cam = workspace.CurrentCamera; if not cam or #enemyList == 0 then return nil, nil end; local ctr = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5); local fov = tonumber(getgenv().Config.TriggerFOV) or 115; local bp, bpl, bm = nil, nil, math.huge; for _, e in ipairs(enemyList) do for _, pt in ipairs({ e.head, e.root }) do if pt and pt.Parent and F.hasLineOfSight(cam.CFrame.Position, pt, e.char) then local sp, on = cam:WorldToViewportPoint(pt.Position); if on and sp.Z > 0 then local m = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude; if m <= fov and m < bm then bm, bp, bpl = m, pt, e.player end end end end end; return bp, bpl end
local function fireHyperBurst(item, oCF, tHead, tChar, enemyList, trigPart) if not item then return end; local id = item:Get("ObjectID"); if not id then return end; local bc = math.max(1, tonumber(getgenv().Config.BurstPackets) or 6); local tgts = #enemyList > 0 and enemyList or { { head = tHead, char = tChar } }; for i = 1, bc do local en = tgts[((i - 1) % #tgts) + 1]; local h = en.head or tHead; local tc = en.char or tChar; if h and h.Parent and F.hasLineOfSight(oCF, h, tc) then local aCF, tCF = CFrame.lookAt(oCF, h.Position), h.CFrame; local ap = h.Position + Vector3.new((math.random() - 0.5) * 0.09, (math.random() - 0.5) * 0.09, (math.random() - 0.5) * 0.09); pcall(function() S.useItemRemote:FireServer(id, S.startShootingEnum, { [S.k1] = { [S.k0] = util:EncodeCFrame(aCF), [S.k1] = util:EncodeCFrame(tCF), [S.k2] = h, [S.k3] = util:EncodeCFrame(h.CFrame:ToObjectSpace(CFrame.new(ap))) } }, nil) end) end end; if getgenv().Config.Triggerbot and trigPart and trigPart.Parent then local tc2 = math.max(1, tonumber(getgenv().Config.TriggerBurst) or 6); for _ = 1, tc2 do local taCF, tpCF = CFrame.lookAt(oCF, trigPart.Position), trigPart.CFrame; local hp = trigPart.Position + Vector3.new((math.random() - 0.5) * 0.06, (math.random() - 0.5) * 0.06, (math.random() - 0.5) * 0.06); pcall(function() S.useItemRemote:FireServer(id, S.startShootingEnum, { [S.k1] = { [S.k0] = util:EncodeCFrame(taCF), [S.k1] = util:EncodeCFrame(tpCF), [S.k2] = trigPart, [S.k3] = util:EncodeCFrame(trigPart.CFrame:ToObjectSpace(CFrame.new(hp))) } }, nil) end) end end end
