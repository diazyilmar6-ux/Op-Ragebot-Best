local function buildNPCClone(char, tag, scf, alpha) if not char then return nil end; char.Archivable = true; local cl = char:Clone(); if not cl then return nil end; cl.Name = tag; for _, v in ipairs(cl:GetDescendants()) do if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("Animator") or v:IsA("Sound") then v:Destroy() elseif v:IsA("BasePart") then v.Anchored = true; v.CanCollide = false; v.Massless = true; if alpha then v.Transparency = math.clamp(math.max(v.Transparency, alpha), 0, 0.92) end elseif v:IsA("Humanoid") then v.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; v.PlatformStand = true end end; if cl.PrimaryPart then cl:SetPrimaryPartCFrame(scf) elseif cl:FindFirstChild("HumanoidRootPart") then cl.HumanoidRootPart.CFrame = scf end; cl.Parent = workspace; return cl end
