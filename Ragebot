		if not part then return end
		local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if myRoot and (part.Position - myRoot.Position).Magnitude > Cfg.ESPDist then DelESP(m) return end
		if ESPs[m] and ESPs[m].hl and ESPs[m].hl.Parent == m then return end
