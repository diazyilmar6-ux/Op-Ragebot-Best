	local function ResetArms()
		if next(DefC0) == nil then return end
		for mot, c0 in pairs(DefC0) do if mot and mot.Parent then mot.C0, mot.Transform = c0, CFrame.identity end end
		table.clear(DefC0)
	end

	local function AimJoint(mot, tPos, str)
		if not mot or not mot:IsA("Motor6D") or not mot.Part0 then return end
		if not DefC0[mot] then DefC0[mot] = mot.C0 end
		local orig = DefC0[mot]
		mot.Transform = CFrame.identity
		if str then mot.C0 = CFrame.new(orig.Position) else
			local dir = tPos - (mot.Part0.CFrame * CFrame.new(orig.Position)).Position
			if dir.Magnitude > 0.001 then
				mot.C0 = CFrame.new(orig.Position) * CFrame.lookAt(Vector3.zero, mot.Part0.CFrame:VectorToObjectSpace(dir.Unit)) * CFrame.Angles(math.rad(90), 0, 0)
			end
		end
	end

	local function ApplyArmsToHead(char, tPos)
		if not char or not tPos then return end
		for _, c in ipairs(Cam:GetChildren()) do
			if c:IsA("Model") then c:PivotTo(CFrame.lookAt(c:GetPivot().Position, tPos))
			elseif c:IsA("Folder") then for _, s in ipairs(c:GetChildren()) do if s:IsA("Model") then s:PivotTo(CFrame.lookAt(s:GetPivot().Position, tPos)) end end end
		end
		local rUp, lUp = char:FindFirstChild("RightUpperArm"), char:FindFirstChild("LeftUpperArm")
		if rUp and lUp then
			AimJoint(rUp:FindFirstChild("RightShoulder"), tPos, false)
			AimJoint(lUp:FindFirstChild("LeftShoulder"), tPos, false)
			local rLo, lLo, rHa, lHa = char:FindFirstChild("RightLowerArm"), char:FindFirstChild("LeftLowerArm"), char:FindFirstChild("RightHand"), char:FindFirstChild("LeftHand")
			if rLo then AimJoint(rLo:FindFirstChild("RightElbow"), tPos, true) end
			if lLo then AimJoint(lLo:FindFirstChild("LeftElbow"), tPos, true) end
			if rHa then AimJoint(rHa:FindFirstChild("RightWrist"), tPos, true) end
			if lHa then AimJoint(lHa:FindFirstChild("LeftWrist"), tPos, true) end
		else
			local torso = char:FindFirstChild("Torso")
			if torso then
				AimJoint(torso:FindFirstChild("Right Shoulder"), tPos, false)
				AimJoint(torso:FindFirstChild("Left Shoulder"), tPos, false)
			end
		end
	end

	-- Silent Aim mejorado y compatible con ejecutores LuaU (Delta)
	local function SetupHook()
		if Hooked then return end
		pcall(function()
			local wrap = newcclosure or function(f) return f end
			local isCaller = checkcaller or function() return false end
			if hookmetamethod and getnamecallmethod then
				local old
				old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
					local m = getnamecallmethod()
					if (Cfg.On or Cfg.RageOn) and CurrentTargetHead and CurrentTargetHead.Parent and not isCaller() then
						local hp = CurrentTargetHead.Position
						if self == Workspace and m == "Raycast" then
							local args = {...}
							if typeof(args[1]) == "Vector3" and typeof(args[2]) == "Vector3" then
								args[2] = (hp - args[1]).Unit * args[2].Magnitude
								return old(self, unpack(args))
							end
						elseif self == Workspace and (m == "FindPartOnRayWithIgnoreList" or m == "FindPartOnRayWithWhitelist" or m == "FindPartOnRay") then
							local args = {...}
							if typeof(args[1]) == "Ray" then
								args[1] = Ray.new(args[1].Origin, (hp - args[1].Origin).Unit * args[1].Direction.Magnitude)
								return old(self, unpack(args))
							end
						end
					end
					return old(self, ...)
				end))
				Hooked = true
			end
		end)
	end
	SetupHook()

	local SavedTrans = {}
	local function SetCharBlink(char, hide)
		if not char then return end
		for _, inst in ipairs(char:GetDescendants()) do
			if inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart" then
				if hide then
					if SavedTrans[inst] == nil then SavedTrans[inst] = inst.LocalTransparencyModifier end
					inst.LocalTransparencyModifier = 1
				elseif SavedTrans[inst] ~= nil then
					inst.LocalTransparencyModifier = SavedTrans[inst]
					SavedTrans[inst] = nil
				end
			elseif inst:IsA("Decal") then
				if hide then
					if SavedTrans[inst] == nil then SavedTrans[inst] = inst.Transparency end
					inst.Transparency = 1
				elseif SavedTrans[inst] ~= nil then
					inst.Transparency = SavedTrans[inst]
					SavedTrans[inst] = nil
				end
			end
		end
	end

