	local function IsVisible(targetModel, targetPart)
		if not Cfg.WallCheck then return true end
		if not targetPart or not targetPart:IsA("BasePart") then return false end
		local origin, delta = Cam.CFrame.Position, targetPart.Position - Cam.CFrame.Position
		local dist = delta.Magnitude
		if dist <= 0.05 then return true end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local filter = {Cam}
		if LP.Character then table.insert(filter, LP.Character) end
		if targetModel then table.insert(filter, targetModel) end
		for _, plr in ipairs(Players:GetPlayers()) do if plr.Character then table.insert(filter, plr.Character) end end
		params.FilterDescendantsInstances, params.IgnoreWater = filter, true
		local dir, curOrigin, remDist = delta.Unit * dist, origin, dist
		for _ = 1, 4 do
			local hit = Workspace:Raycast(curOrigin, dir.Unit * remDist, params)
			if not hit then return true end
			local inst = hit.Instance
			local isGhost = (not inst.CanCollide and inst.Transparency >= 0.9) or inst:IsA("Accessory") or inst:IsA("Tool") or inst.Name == "ViewModel" or inst.Name == "Arms"
			if isGhost then
				table.insert(filter, inst)
				params.FilterDescendantsInstances = filter
				remDist = dist - (hit.Position - origin).Magnitude - 0.05
				curOrigin = hit.Position + dir.Unit * 0.05
				if remDist <= 0.05 then return true end
			else
				return false
			end
		end
		return false
	end

	local function HpCol(pct)
		pct = math.clamp(pct, 0, 1)
		if pct > 0.5 then
			local t = (1 - pct) * 2
			return Color3.fromRGB(math.floor(50 + 195 * t), math.floor(235 - 20 * t), math.floor(120 - 65 * t))
		end
		local t = (0.5 - pct) * 2
		return Color3.fromRGB(math.floor(245 - 5 * t), math.floor(215 - 160 * t), math.floor(55 + 15 * t))
	end

	local function NewD(t, p)
		if not HasDrawing then return nil end
		local s, d = pcall(function() local o = Drawing.new(t) for k, v in pairs(p) do o[k] = v end return o end)
		return s and d or nil
	end

	local function HideBox(box)
