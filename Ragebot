	local function RenderBoxes()
		local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local myPos = myRoot and myRoot.Position
		for m, d in pairs(ESPs) do
			local hum, box = d.hum, d.box
			if not m or not m.Parent or not hum or not hum.Parent or hum.Health <= 0 or m == LP.Character then HideBox(box) continue end
			local root = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("UpperTorso") or m:FindFirstChild("Torso") or d.part
			if not root or not root:IsA("BasePart") or (myPos and (root.Position - myPos).Magnitude > Cfg.ESPDist) then HideBox(box) continue end

			local cf, sz = m:GetBoundingBox()
			local hx, ty, by, px, pz = math.max(sz.X * 0.52, 1.35), cf.Position.Y + sz.Y * 0.52, cf.Position.Y - sz.Y * 0.52, cf.Position.X, cf.Position.Z
			local pts = {
				Vector3.new(px - hx, ty, pz - hx), Vector3.new(px + hx, ty, pz - hx), Vector3.new(px - hx, ty, pz + hx), Vector3.new(px + hx, ty, pz + hx),
				Vector3.new(px - hx, by, pz - hx), Vector3.new(px + hx, by, pz - hx), Vector3.new(px - hx, by, pz + hx), Vector3.new(px + hx, by, pz + hx)
			}
			local minX, minY, maxX, maxY, visAny = math.huge, math.huge, -math.huge, -math.huge, false
			for i = 1, 8 do
				local sp, v = Cam:WorldToViewportPoint(pts[i])
				if v and sp.Z > 0 then visAny = true end
				if sp.X < minX then minX = sp.X end if sp.Y < minY then minY = sp.Y end
				if sp.X > maxX then maxX = sp.X end if sp.Y > maxY then maxY = sp.Y end
			end
			if not visAny or maxX <= minX or maxY <= minY then HideBox(box) continue end

			local vpX, vpY = Cam.ViewportSize.X, Cam.ViewportSize.Y
			minX, maxX = math.clamp(minX, -200, vpX + 200), math.clamp(maxX, -200, vpX + 200)
			minY, maxY = math.clamp(minY, -200, vpY + 200), math.clamp(maxY, -200, vpY + 200)
			local w, h = math.max(8, maxX - minX), math.max(14, maxY - minY)
			local pct = math.clamp(hum.Health, 0, math.max(1, hum.MaxHealth)) / math.max(1, hum.MaxHealth)
			local hc = HpCol(pct)
			local bw, bh = math.clamp(w * 0.08, 3, 5), math.max(2, h * pct)
			local bx, by2 = minX - bw - 4, minY + (h - bh)
			local col = (CurrentTargetHead and CurrentTargetHead:IsDescendantOf(m)) and Color3.fromRGB(50, 235, 130) or hc

			if box.outline then box.outline.Position, box.outline.Size, box.outline.Visible = Vector2.new(minX, minY), Vector2.new(w, h), true end
			if box.rect then box.rect.Position, box.rect.Size, box.rect.Color, box.rect.Visible = Vector2.new(minX, minY), Vector2.new(w, h), col, true end
			if box.hpBg then box.hpBg.Position, box.hpBg.Size, box.hpBg.Visible = Vector2.new(bx, minY), Vector2.new(bw, h), true end
			if box.hpBar then box.hpBar.Position, box.hpBar.Size, box.hpBar.Color, box.hpBar.Visible = Vector2.new(bx, by2), Vector2.new(bw, bh), hc, true end
			if box.hpBorder then box.hpBorder.Position, box.hpBorder.Size, box.hpBorder.Visible = Vector2.new(bx, minY), Vector2.new(bw, h), true end
		end
	end

	local function UpdateESP()
		local now = os.clock()
		if now - LastESPUpdate < 0.15 then return end
		LastESPUpdate = now
		local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local myPos = myRoot and myRoot.Position
		for m, hum in pairs(Chars) do
			if not m or not m.Parent or not hum or not hum.Parent or m == LP.Character or hum.Health <= 0 then DelESP(m) continue end
			local part = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChildWhichIsA("BasePart")
			if not part then DelESP(m) continue end
			local dist = myPos and (part.Position - myPos).Magnitude or 0
			if dist <= Cfg.ESPDist then
				if not ESPs[m] or not ESPs[m].hl or ESPs[m].hl.Parent ~= m then AddESP(m, hum) end
				local d = ESPs[m]
				if d and d.txt then
					local hp = math.clamp(hum.Health, 0, math.max(1, hum.MaxHealth))
					d.txt.TextColor3 = HpCol(hp / math.max(1, hum.MaxHealth))
					d.txt.Text = string.format("%s | %d HP | %dm", d.name, math.floor(hp), math.floor(dist))
				end
			else
				DelESP(m)
			end
		end
	end

	local function RegHum(hum)
		if not hum or not hum:IsA("Humanoid") then return end
		local m = hum.Parent
		if m and m:IsA("Model") and not Chars[m] then
			Chars[m] = hum
			if Cfg.On then AddESP(m, hum) end
			hum.Died:Connect(function() DelESP(m) end)
			m.AncestryChanged:Connect(function(_, p) if not p then Chars[m] = nil DelESP(m) end end)
		end
