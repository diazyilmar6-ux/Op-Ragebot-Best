	local function isEnemy(p)
		if p == LP then return false end
		if okMods and SpectateController then
			local duel = SpectateController.CurrentDuelSubject
			local d = duel and duel:GetDueler(LP)
			local t = d and d:Get("TeamID")
			if t and duel.Duelers then
				for _, du in ipairs(duel.Duelers) do
					if du.Player == p then return du:Get("TeamID") ~= t end
				end
			end
		end
		return (p:GetAttribute("TeamID") or 0) ~= (LP:GetAttribute("TeamID") or 1)
	end

