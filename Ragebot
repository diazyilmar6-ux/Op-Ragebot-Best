		txt.TextColor3, txt.TextStrokeTransparency, txt.TextStrokeColor3 = Color3.fromRGB(255, 240, 248), 0.2, Color3.fromRGB(12, 14, 18)

		local name = plr and plr.DisplayName or m.Name
		local hp = math.clamp(hum.Health, 0, math.max(1, hum.MaxHealth))
		local dist = myRoot and math.floor((part.Position - myRoot.Position).Magnitude) or 0
		txt.Text = string.format("%s | %d HP | %dm", name, math.floor(hp), dist)

		ESPs[m] = {
			hl = hl, bb = bb, txt = txt, hum = hum, part = part, name = name,
