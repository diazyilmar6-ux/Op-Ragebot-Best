	RunService.Heartbeat:Connect(function()
		if not Cfg.RageOn or not okMods or not FighterController or not FighterController.Objects then return end
		local now = tick()
		local clk = os.clock()

		if clk - LastBlink >= Cfg.BlinkInterval then
			LastBlink = clk
			BlinkHidden = not BlinkHidden
			SetCharBlink(LP.Character, BlinkHidden)
		end

		local selectedP, selectedR, selectedH, minDist = nil, nil, nil, 500
		local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")

		for _, obj in pairs(FighterController.Objects) do
			local p = obj.Player
			if p and isEnemy(p) and obj.Entity and obj.Entity:IsAlive() and not obj:Get("IsSpectating") then
				local wepName = getBaseWeaponName(obj.EquippedItem)
				if not (wepName and pauseWeapons[wepName]) then
					local pChar = p.Character
					local r = pChar and pChar:FindFirstChild("HumanoidRootPart")
					local h = pChar and pChar:FindFirstChild("Head")
					if r and h and myRoot then
						local dist = (myRoot.Position - r.Position).Magnitude
						if dist < minDist then
							minDist, selectedP, selectedR, selectedH = dist, p, r, h
						end
					end
				end
			end
		end

		if selectedH and selectedH.Parent then
			CurrentTargetHead = selectedH
		end

		RageSub.Text = selectedP and ("🎯 " .. selectedP.Name .. " (" .. transW(getBaseWeaponName(FighterController.LocalFighter and FighterController.LocalFighter.EquippedItem)) .. ")") or "⏳ Buscando objetivo..."

		if not selectedP or not selectedH or not selectedR or not myRoot or not FighterController.LocalFighter then
			return
		end

		local targetPos = (selectedR.CFrame * CFrame.new(0, 5.0, -2.0)).Position
		local stableCF = CFrame.lookAt(targetPos, selectedH.Position)

		local oldCF = myRoot.CFrame
		local oldVel = myRoot.AssemblyLinearVelocity
		local oldRotVel = myRoot.AssemblyAngularVelocity

		local flatLook = Vector3.new(selectedH.Position.X, oldCF.Position.Y, selectedH.Position.Z)
		local moveCF = (flatLook - oldCF.Position).Magnitude > 0.05 and CFrame.lookAt(oldCF.Position, flatLook) or oldCF

		if BlinkHidden then
			pcall(function()
				myRoot.AssemblyLinearVelocity = Vector3.zero
				myRoot.AssemblyAngularVelocity = Vector3.zero
				myRoot.CFrame = stableCF
			end)
			pcall(function()
				RunService:BindToRenderStep("__restore", 101, function()
					if myRoot then
						myRoot.CFrame = moveCF
						myRoot.AssemblyLinearVelocity = oldVel
						myRoot.AssemblyAngularVelocity = oldRotVel
					end
					RunService:UnbindFromRenderStep("__restore")
				end)
			end)
		else
			pcall(function()
				myRoot.CFrame = moveCF
			end)
		end

		local item = FighterController.LocalFighter.EquippedItem
		if not item or not useItemRemote or not startShootingEnum or (now - lastFire) < Cfg.FireRate then return end
		lastFire = now

		local originPos, targetPosAim = stableCF.Position, selectedH.Position
		local aimCF, targetCF = CFrame.lookAt(originPos, targetPosAim), selectedH.CFrame
		local aimedPos = targetPosAim + Vector3.new((math.random() - 0.5) * 0.1, (math.random() - 0.5) * 0.1, (math.random() - 0.5) * 0.1)

		pcall(function()
			useItemRemote:FireServer(item:Get("ObjectID"), startShootingEnum, {
				[k1] = {
					[k0] = util:EncodeCFrame(aimCF),
					[k1] = util:EncodeCFrame(targetCF),
					[k2] = selectedH,
					[k3] = util:EncodeCFrame(selectedH.CFrame:ToObjectSpace(CFrame.new(aimedPos)))
				}
			}, nil)
		end)
	end)

	local function GetTarget()
		local bestD, bestH = Cfg.AimFOV, nil
		local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if not root then return nil end
		local myPos, ctr = root.Position, Vector2.new(Cam.ViewportSize.X * 0.5, Cam.ViewportSize.Y * 0.5)
		for m, hum in pairs(Chars) do
			if m and m.Parent and hum and hum.Parent and m ~= LP.Character and hum.Health > 0 then
				local plr = Players:GetPlayerFromCharacter(m)
				if Cfg.TeamCheck and plr and plr.Team == LP.Team then continue end
				local head = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
				if not head or not head:IsA("BasePart") or (head.Position - myPos).Magnitude > Cfg.MaxDist then continue end
				if not IsVisible(m, head) then continue end

				local minD = math.huge
				for _, pn in ipairs(CheckParts) do
					local p = m:FindFirstChild(pn)
					if p and p:IsA("BasePart") then
						local sp, v = Cam:WorldToViewportPoint(p.Position)
						if v and sp.Z > 0 then
							local d = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
							if d < minD then minD = d end
						end
					end
				end
				if minD <= bestD then bestD, bestH = minD, head end
			end
		end
		return bestH
	end

