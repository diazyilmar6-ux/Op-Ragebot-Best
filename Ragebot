	local function StepTPWalk(char, root, hum)
		if not Cfg.On or not Cfg.TPWalkEnabled or not root or not hum or hum.Health <= 0 then return end
		local md = hum.MoveDirection
		if md.Magnitude <= 0.05 then return end
		local now = os.clock()
		if now - LastStep < 0.05 then return end
		LastStep = now

		local dir = Vector3.new(md.X, 0, md.Z)
		if dir.Magnitude < 0.01 then return end
		dir = dir.Unit

		local desiredStep = Cfg.TPWalkPower * 0.14
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local filter = {char, Cam}
		for _, plr in ipairs(Players:GetPlayers()) do if plr.Character then table.insert(filter, plr.Character) end end
		params.FilterDescendantsInstances, params.IgnoreWater = filter, true

		local safeDist = desiredStep
		for _, yOff in ipairs({0, 1.5, -1.2}) do
			local origin = root.Position + Vector3.new(0, yOff, 0)
			local hit = Workspace:Raycast(origin, dir * (safeDist + 1.15), params)
			if hit and hit.Instance and hit.Instance.CanCollide and hit.Normal.Y < 0.55 then
				local allowed = (hit.Position - origin).Magnitude - 1.25
				if allowed < safeDist then safeDist = math.max(0, allowed) end
			end
		end

		if safeDist <= 0.02 then return end
		local nextPos = root.Position + dir * safeDist
		local groundHit = Workspace:Raycast(nextPos + Vector3.new(0, 1.2, 0), Vector3.new(0, -4.2, 0), params)
		if groundHit and hum.FloorMaterial ~= Enum.Material.Air then
			nextPos = Vector3.new(nextPos.X, groundHit.Position.Y + 2.85, nextPos.Z)
		end

		pcall(function()
			root.CFrame = CFrame.new(nextPos) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0)
		end)
	end

