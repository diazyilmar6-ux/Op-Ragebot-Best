				rect = NewD("Square", {Visible = false, Thickness = 1.3, Filled = false, Color = Color3.fromRGB(255, 115, 185), Transparency = 0.95}),
				hpBg = NewD("Square", {Visible = false, Thickness = 1, Filled = true, Color = Color3.fromRGB(14, 16, 22), Transparency = 0.78}),
				hpBar = NewD("Square", {Visible = false, Thickness = 1, Filled = true, Color = Color3.fromRGB(50, 235, 120), Transparency = 0.96}),
				hpBorder = NewD("Square", {Visible = false, Thickness = 1, Filled = false, Color = Color3.fromRGB(5, 6, 9), Transparency = 0.9})
			}
		}
	end
