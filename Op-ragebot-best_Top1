local function loadSavedConfig()
	local cfg = {}
	for k, v in pairs(defaultCfg) do cfg[k] = v end
	local raw = getgenv()._RV_RAW_SAVE
	if not raw and type(isfile) == "function" and type(readfile) == "function" and isfile(SAVE_FILE) then
		local ok, data = pcall(readfile, SAVE_FILE)
		if ok and data then raw = data end
	end
	if raw then
		local ok, decoded = pcall(function() return httpS:JSONDecode(raw) end)
		if ok and type(decoded) == "table" then
			for k, v in pairs(decoded) do if cfg[k] ~= nil then cfg[k] = v end end
		end
	end
	return cfg
end

local function saveConfig()
	local cfg = getgenv().Config
	if not cfg then return end
	local ok, encoded = pcall(function() return httpS:JSONEncode(cfg) end)
	if ok and encoded then
		getgenv()._RV_RAW_SAVE = encoded
		if type(writefile) == "function" then pcall(writefile, SAVE_FILE, encoded) end
	end
end

getgenv().Config = loadSavedConfig()

