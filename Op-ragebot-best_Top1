function S.getTeamID(p)
	if not p then return nil end
	local duel = SpectateController.CurrentDuelSubject
	if duel and duel.Duelers then
		for _, du in ipairs(duel.Duelers) do
			if du.Player == p then
				local tid = du:Get("TeamID")
				if tid == nil then tid = du.TeamID end
				if tid ~= nil then return tid end
			end
		end
	end
	if p:GetAttribute("TeamID") ~= nil then return p:GetAttribute("TeamID") end
	if p.Team then return p.Team end
	return nil
end

function S.isEnemy(p)
	if not p or p == lplr then return false end
	local a, b = S.getTeamID(lplr), S.getTeamID(p)
	return (a ~= nil and b ~= nil) and (a ~= b) or true
end

function S.isTeammate(p)
	if not p or p == lplr then return false end
	local a, b = S.getTeamID(lplr), S.getTeamID(p)
	return (a ~= nil and b ~= nil) and (a == b) or false
end

function S.isTeammateAlive()
	if S.getTeamID(lplr) == nil then return false end
	for _, p in ipairs(plrs:GetPlayers()) do
		if S.isTeammate(p) and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			local obj = FighterController.Objects and FighterController.Objects[p]
			local alive = (obj and obj.Entity) and obj.Entity:IsAlive() or (hum and hum.Health > 0)
			if alive and hum and hum.Health > 0 then return true, p end
		end
	end
	return false, nil
end

function S.hasLineOfSight(oPos, part, tChar)
	if not part or not part.Parent then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ign = {}
	if lplr.Character then table.insert(ign, lplr.Character) end
	if S.npcs.v then table.insert(ign, S.npcs.v) end
	if S.npcs.b then table.insert(ign, S.npcs.b) end
	for _, v in ipairs(workspace:GetChildren()) do
		if v:IsA("Model") and (v.Name == "__NPC_Floating500k" or v.Name == "__NPC_BehindTarget") then table.insert(ign, v) end
	end
	params.FilterDescendantsInstances = ign
	params.IgnoreWater = true
	local dir = part.Position - oPos
	local dist = dir.Magnitude
	if dist <= 0.1 then return true end
	local res = workspace:Raycast(oPos, dir.Unit * dist, params)
	return (not res) or (tChar and res.Instance:IsDescendantOf(tChar)) or (res.Instance == part)
end

local function clearESP()
	for p, d in pairs(S.espCache) do
		if d.billboard then pcall(function() d.billboard:Destroy() end) end
		if d.box then pcall(function() d.box:Destroy() end) end
		S.espCache[p] = nil
	end
end

local function updateESP(myRoot)
	if not (getgenv().Config.Enabled and getgenv().Config.ESP) then clearESP(); return end
	for p, d in pairs(S.espCache) do
		if not p.Parent or not S.isEnemy(p) or not p.Character then
			if d.billboard then pcall(function() d.billboard:Destroy() end) end
			if d.box then pcall(function() d.box:Destroy() end) end
			S.espCache[p] = nil
		end
	end
	for _, p in ipairs(plrs:GetPlayers()) do
		if S.isEnemy(p) and p.Character then
			local c = p.Character
			local hrp, head, hum = c:FindFirstChild("HumanoidRootPart"), c:FindFirstChild("Head"), c:FindFirstChildOfClass("Humanoid")
			if hrp and head and hum and hum.Health > 0 then
				local e = S.espCache[p]
				if not e then
					e = {}
					local box = Instance.new("BoxHandleAdornment"); box.Name = "__RageESPBox"; box.Adornee = hrp; box.Size = Vector3.new(4.2, 5.6, 2.5); box.Color3 = Color3.fromRGB(255, 60, 60); box.Transparency = 0.72; box.ZIndex = 5; box.AlwaysOnTop = true; box.Parent = hrp; e.box = box
					local bb = Instance.new("BillboardGui"); bb.Name = "__RageESPInfo"; bb.Adornee = head; bb.Size = UDim2.new(0, 180, 0, 46); bb.StudsOffset = Vector3.new(0, 2.6, 0); bb.AlwaysOnTop = true; bb.Parent = head
					local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1, 0, 1, 0); lbl.BackgroundTransparency = 1; lbl.TextColor3 = Color3.new(1, 1, 1); lbl.TextStrokeTransparency = 0.2; lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 11; lbl.TextWrapped = true; lbl.Parent = bb; e.billboard = bb; e.label = lbl
					S.espCache[p] = e
				end
				local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
				e.label.Text = string.format("%s\nHP: %d/%d | %d studs", p.Name, math.floor(hum.Health), math.max(1, math.floor(hum.MaxHealth)), dist)
			elseif S.espCache[p] then
				if S.espCache[p].billboard then pcall(function() S.espCache[p].billboard:Destroy() end) end
				if S.espCache[p].box then pcall(function() S.espCache[p].box:Destroy() end) end
				S.espCache[p] = nil
			end
		end
	end
end

local function setCharacterInvisible(char, inv)
	if not char then return end
	for _, v in ipairs(char:GetDescendants()) do
		if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
			if inv then
				if S.savedTransparencies[v] == nil then S.savedTransparencies[v] = v.Transparency end
				v.LocalTransparencyModifier = 1; v.Transparency = 1
			elseif S.savedTransparencies[v] ~= nil then
				v.LocalTransparencyModifier = 0; v.Transparency = S.savedTransparencies[v]; S.savedTransparencies[v] = nil
			end
		elseif v:IsA("Decal") or v:IsA("Texture") then
			if inv then if S.savedTransparencies[v] == nil then S.savedTransparencies[v] = v.Transparency end; v.Transparency = 1
			elseif S.savedTransparencies[v] ~= nil then v.Transparency = S.savedTransparencies[v]; S.savedTransparencies[v] = nil end
		end
	end
end

