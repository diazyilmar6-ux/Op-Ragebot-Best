local function pushLog(rem,kind,args)
	if State.Paused or typeof(rem)~="Instance"or not(rem:IsA("RemoteEvent")or rem:IsA("RemoteFunction"))or type(args)~="table"or#args==0 or not rem.Parent then return end
	local okN,n=pcall(function()return rem.Name end);local okP,p=pcall(function()return rem:GetFullName()end)
	if not(okN and okP)then return end
	table.insert(State.Logs,{Remote=rem,Name=n,Path=p,Kind=kind,Args=args,Time=os.date("%H:%M:%S")})
	if#State.Logs>250 then table.remove(State.Logs,1)end
	refreshLogs()
end

