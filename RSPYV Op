makeToggle("Jump (300 + Inf)","JumpPower 300 y salto infinito",2,function(v)State.JumpEnabled=v;State.InfiniteJumpEnabled=v;local h=getHum();if h then h.UseJumpPower=true;h.JumpPower=v and 300 or 50 end end)
makeToggle("Noclip","CanCollide = false en personaje",3,function(v)State.NoclipEnabled=v;if not v and LocalPlayer and LocalPlayer.Character then for _,p in ipairs(LocalPlayer.Character:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=true end end end end)
makeToggle("Invisible","LocalTransparencyModifier en partes",4,function(v)State.InvisibleEnabled=v;pcall(function()local c=LocalPlayer and LocalPlayer.Character;if c then for _,p in ipairs(c:GetDescendants())do if p:IsA("BasePart")and p.Name~="HumanoidRootPart"then p.LocalTransparencyModifier=v and 1 or 0 end end end end)end)
makeToggle("TP Tool","Teletransporta al punto apuntado",5,function(v)State.TpToolEnabled=v;if v then giveTP()elseif tpTool then tpTool:Destroy();tpTool=nil end end)
makeToggle("ESP Enemigos","Resalta enemigos con Highlight",6,function(v)State.EspEnabled=v;updESP()end)

UserInputService.JumpRequest:Connect(function()if State.InfiniteJumpEnabled then pcall(function()local h=getHum();if h then h:ChangeState(Enum.HumanoidStateType.Jumping)end end)end end)
RunService.Stepped:Connect(function()if State.NoclipEnabled then pcall(function()local c=LocalPlayer and LocalPlayer.Character;if c then for _,p in ipairs(c:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=false end end end end)end end)
RunService.Heartbeat:Connect(function()
	if State.SpeedEnabled then pcall(function()local h=getHum();if h and h.WalkSpeed~=100 then h.WalkSpeed=100 end end)end
	if State.JumpEnabled then pcall(function()local h=getHum();if h then h.UseJumpPower=true;if h.JumpPower~=300 then h.JumpPower=300 end end end)end
	if State.InvisibleEnabled then pcall(function()local c=LocalPlayer and LocalPlayer.Character;if c then for _,p in ipairs(c:GetDescendants())do if p:IsA("BasePart")and p.Name~="HumanoidRootPart"then p.LocalTransparencyModifier=1 end end end end)end
end)
LocalPlayer.CharacterAdded:Connect(function()task.wait(0.4);if State.TpToolEnabled then pcall(giveTP)end;if State.EspEnabled then pcall(updESP)end end)
Players.PlayerAdded:Connect(function(p)p.CharacterAdded:Connect(function()if State.EspEnabled then task.wait(0.3);pcall(updESP)end end)end)
Players.PlayerRemoving:Connect(function()if State.EspEnabled then pcall(updESP)end end)
