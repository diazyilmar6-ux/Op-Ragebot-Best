local function ser(v,d,vis)
	d=d or 0;vis=vis or{};local t=typeof(v)
	if t=="string"then return string.format("%q",v)
	elseif t=="number"or t=="boolean"or t=="nil"then return tostring(v)
	elseif t=="Vector3"then return string.format("Vector3.new(%.2f,%.2f,%.2f)",v.X,v.Y,v.Z)
	elseif t=="Vector2"then return string.format("Vector2.new(%.2f,%.2f)",v.X,v.Y)
	elseif t=="CFrame"then return string.format("CFrame.new(%.2f,%.2f,%.2f)",v.Position.X,v.Position.Y,v.Position.Z)
	elseif t=="Color3"then return string.format("Color3.fromRGB(%d,%d,%d)",math.round(v.R*255),math.round(v.G*255),math.round(v.B*255))
	elseif t=="UDim2"then return string.format("UDim2.new(%.2f,%d,%.2f,%d)",v.X.Scale,v.X.Offset,v.Y.Scale,v.Y.Offset)
	elseif t=="Instance"then local ok,fn=pcall(function()return v:GetFullName()end);return"Instance("..(ok and fn or tostring(v))..")"
	elseif t=="table"then
		if d>=3 then return"{...}"end
		if vis[v]then return"{<circular>}"end
		vis[v]=true;local out,n={},0
		for k,val in pairs(v)do
			n+=1;if n>15 then table.insert(out,"...");break end
			local ks=(type(k)=="string")and("["..string.format("%q",k).."]")or("["..tostring(k).."]")
			table.insert(out,ks.."="..ser(val,d+1,vis))
		end
		vis[v]=nil;return"{"..table.concat(out,", ").."}"
	end
	return t.."("..tostring(v)..")"
end

local function fmtArgs(args)
	if#args==0 then return""end
	local r={};for i=1,#args do r[i]=string.format("[%d] %s",i,ser(args[i],0,{}))end
	return table.concat(r,"\n")
end

